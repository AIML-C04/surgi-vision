# ============================================================
# SurgiVision AI - Environment Configuration Example
# ============================================================
# Copy this file to .env and replace the placeholder values.
# NEVER commit .env or real credentials to Git.
# ============================================================


# ------------------------------------------------------------
# Legacy / Local PostgreSQL Configuration
# ------------------------------------------------------------
# These are kept for local Docker/development compatibility.
# The application database connection is controlled by DATABASE_URL.

POSTGRES_USER=surgivision
POSTGRES_PASSWORD=change_me
POSTGRES_DB=surgivision


# ------------------------------------------------------------
# Backend Settings
# ------------------------------------------------------------

# Generate a strong random secret for your local .env.
# Example:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_secret


# Supabase PostgreSQL connection.
# Use the Supabase Session Pooler URI (port 5432).
#
# Example format:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres


# ------------------------------------------------------------
# Storage Configuration
# ------------------------------------------------------------

# Supported providers:
# local
# supabase
STORAGE_PROVIDER=supabase

# Supabase Project URL
# Example:
# https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase Secret API key.
# BACKEND ONLY - NEVER expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_KEY

# Private Supabase Storage bucket used for surgical videos.
SUPABASE_BUCKET=surgivision-videos


# ------------------------------------------------------------
# AI Model Configuration
# ------------------------------------------------------------

# Supported providers:
# mock
# local
# real
MODEL_PROVIDER=real

# Path to the surgical instrument detection model
MODEL_PATH=models/yolov8s_cholec80.pt

# Minimum confidence threshold for detections
MODEL_CONFIDENCE_THRESHOLD=0.5

# Process every Nth frame during video analysis.
PROCESS_EVERY_N_FRAMES=5


# ------------------------------------------------------------
# RAG / LLM Configuration
# ------------------------------------------------------------

# Supported providers:
# mock
# huggingface
LLM_PROVIDER=huggingface

# Hugging Face access token.
# Keep this backend-only and never expose it to React.
HF_TOKEN=YOUR_HUGGINGFACE_TOKEN

# LLM used for video-specific Q&A.
LLM_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1


# ------------------------------------------------------------
# Frontend
# ------------------------------------------------------------

# FastAPI backend URL
VITE_API_URL=http://localhost:8000